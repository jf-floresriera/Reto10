<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base de la ventana; los colores reales viven en ui/theme (Compose). -->
    <style name="Theme.EvaExplorer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/verde_campo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
    </style>

    <color name="verde_campo">#FF005828</color>
    <color name="fondo">#FFF7F7F7</color>
</resources>
